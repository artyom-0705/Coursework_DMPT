 141:Core/Src/utils.c **** /* ===================== ДВИЖЕНИЕ ПРЯМО ===================== */
 142:Core/Src/utils.c **** 
 143:Core/Src/utils.c **** void moveStraight(float distance_cm)
 144:Core/Src/utils.c **** {
 145:Core/Src/utils.c **** 
 146:Core/Src/utils.c ****     // Обнуляем ПИД регуляторы
 147:Core/Src/utils.c ****     PID_Reset(&pidYaw);
 148:Core/Src/utils.c ****     PID_Reset(&pidSync);
 149:Core/Src/utils.c **** 
 150:Core/Src/utils.c ****     // Обнуляем энкодеры
 151:Core/Src/utils.c ****     __disable_irq();
 152:Core/Src/utils.c ****     left_encoder_ticks = 0;
 153:Core/Src/utils.c ****     right_encoder_ticks = 0;
 154:Core/Src/utils.c ****     __enable_irq();
 155:Core/Src/utils.c **** 
 156:Core/Src/utils.c ****     // Записываем угл в начальный момент времени (для выр
 157:Core/Src/utils.c ****     MPU_Update();
 158:Core/Src/utils.c ****     float startYaw = MPU_GetYaw();
 159:Core/Src/utils.c **** 
 160:Core/Src/utils.c ****     // Расчет количества тиков для достижения цели
 161:Core/Src/utils.c ****     uint32_t targetTicks =
 162:Core/Src/utils.c ****         (distance_cm * 10.0f / (2 * PI * WHEEL_DIAMETER)) * PULSES_PER_REV;
 163:Core/Src/utils.c **** 
 164:Core/Src/utils.c ****     // Запись времени для обновления скорости раз в пром�
 165:Core/Src/utils.c ****     uint32_t lastTime = millis();
 166:Core/Src/utils.c **** 
 167:Core/Src/utils.c ****     while (1)
 168:Core/Src/utils.c ****     {
 169:Core/Src/utils.c ****         // Проверяем прошло ли время
 170:Core/Src/utils.c ****         if (millis() - lastTime < CONTROL_PERIOD_MS)
 171:Core/Src/utils.c ****             continue;
 172:Core/Src/utils.c **** 
 173:Core/Src/utils.c ****         // Считываем правый и левый энкодер, рассчитываем �
 174:Core/Src/utils.c ****         __disable_irq();
 175:Core/Src/utils.c ****         uint16_t L = left_encoder_ticks;
 176:Core/Src/utils.c ****         uint16_t R = right_encoder_ticks;
 177:Core/Src/utils.c ****         __enable_irq();
 178:Core/Src/utils.c ****         
 179:Core/Src/utils.c ****         uint16_t avg = (uint16_t)((L + R) / 2.0f);
 180:Core/Src/utils.c **** 
 181:Core/Src/utils.c ****         int32_t distErr = targetTicks - avg;
 182:Core/Src/utils.c **** 
 183:Core/Src/utils.c ****         if (abs(distErr) <= POSITION_EPS)
 184:Core/Src/utils.c ****         {
 185:Core/Src/utils.c ****             break;
 186:Core/Src/utils.c ****         }
 187:Core/Src/utils.c **** 
 188:Core/Src/utils.c ****         float basePWM = 630;
 189:Core/Src/utils.c **** 
 190:Core/Src/utils.c ****         if (distErr < 150)
 191:Core/Src/utils.c ****         {
 192:Core/Src/utils.c ****             basePWM = 620;
 193:Core/Src/utils.c ****         }
 194:Core/Src/utils.c ****         else if (distErr < 50)
 195:Core/Src/utils.c ****         {
 196:Core/Src/utils.c ****             basePWM = 615;
 197:Core/Src/utils.c ****         }
ARM GAS  C:\Users\parni\AppData\Local\Temp\ccbSD9Ne.s 			page 16


 198:Core/Src/utils.c **** 
 199:Core/Src/utils.c ****         // Записываем сколько времени прошло
 200:Core/Src/utils.c ****         float dt = (millis() - lastTime) / 1000.0f;
 201:Core/Src/utils.c ****         lastTime = millis();
 202:Core/Src/utils.c **** 
 203:Core/Src/utils.c **** 
 204:Core/Src/utils.c ****         // ПИД настройки движения по заданной прямой, то ес
 205:Core/Src/utils.c ****         MPU_Update();
 206:Core/Src/utils.c ****         float yawCorr = PID(&pidYaw,
 207:Core/Src/utils.c ****                             startYaw - MPU_GetYaw(), dt);
 208:Core/Src/utils.c ****         // ПИД контролирующий одинаковое ли расстояние пр�
 209:Core/Src/utils.c ****         float syncCorr = PID(&pidSync, L - R, dt);
 210:Core/Src/utils.c **** 
 211:Core/Src/utils.c ****         // Расчет результирующего ШИМ сигнала
 212:Core/Src/utils.c ****         float pwmL = basePWM - yawCorr - syncCorr;
 213:Core/Src/utils.c ****         float pwmR = basePWM + yawCorr + syncCorr;
 214:Core/Src/utils.c **** 
 215:Core/Src/utils.c ****         // Проверка входит ли он в диапазон возможного ШИМ
 216:Core/Src/utils.c ****         pwmL = constrainf(pwmL, PWM_MIN, 650);
 217:Core/Src/utils.c ****         pwmR = constrainf(pwmR, PWM_MIN, 650);
 218:Core/Src/utils.c **** 
 219:Core/Src/utils.c ****         left_dir(1);
 220:Core/Src/utils.c ****         right_dir(1);
 221:Core/Src/utils.c ****         PWM_Left(pwmL);
 222:Core/Src/utils.c ****         PWM_Right(pwmR);
 223:Core/Src/utils.c ****     }
 224:Core/Src/utils.c **** 
 225:Core/Src/utils.c ****     // Останавливаем моторы робота
 226:Core/Src/utils.c ****     stopMotors();
 227:Core/Src/utils.c ****     delay_ms(200);
 228:Core/Src/utils.c ****     MPU_Update();
 229:Core/Src/utils.c ****     turnByAngle(normalizeAngle(startYaw - MPU_GetYaw()));
